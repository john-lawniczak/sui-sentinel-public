# Export these variables in your shell; .env is not loaded automatically.
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# Optional provider authentication. Use x-token for QuickNode; authorization adds Bearer.
SUI_API_KEY=
SUI_API_KEY_HEADER=authorization
# Explicit offset selected once before snapshots; use measured provider indexing lag.
SUI_SNAPSHOT_CHECKPOINT_LAG=0

# Development gRPC (free public endpoint; not a production SLA).
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
SUI_GRPC_API_KEY=
# Set a provider-specific header when moving providers. authorization adds Bearer.
SUI_GRPC_API_KEY_HEADER=authorization
# Local/managed PostgreSQL, receiver and optional Bearer authentication.
DIAGNOSIS_DATABASE_URL=postgres://sentinel:CHANGE_ME@127.0.0.1:5432/sentinel
SENTINEL_WEBHOOK_URL=http://127.0.0.1:8080/incidents
SENTINEL_WEBHOOK_TOKEN=
# Use discord for an incoming Discord webhook; its complete URL is a secret.
SENTINEL_WEBHOOK_FORMAT=generic
# Production secret/role setup is documented in docs/operations-release.md.
# Optional read-only MCP process; use sentinel_reader, never migration credentials.
# SENTINEL_QUERY_DATABASE_URL=postgres://sentinel_reader:ENCODED_SECRET@db:5432/sentinel
# SENTINEL_MCP_TOKEN=INJECT_AT_LEAST_32_RANDOM_ASCII_BYTES_FOR_PRIVATE_HTTP
# Container entrypoint also supports SENTINEL_QUERY_DATABASE_URL_FILE and SENTINEL_MCP_TOKEN_FILE.
